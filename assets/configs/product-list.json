{
  "syscode": "admin-product-list",
  "restUrl": "/api/admin/product",
  "deleteUrl": "/api/admin/product/${item.id}",
  "pagination": { "limit": 20 },
  "factory": { "url": "${name}--$${id}" },
  "fields": [
    {
      "name": "name",
      "type": "text",
      "label": "$.product.name",
      "operator": { "value": "$regex", "enabled": true },
      "clearable": true
    },
    {
      "name": "sku",
      "type": "text",
      "label": "$.product.sku",
      "operator": { "value": "$regex", "enabled": true },
      "clearable": true
    },
    {
      "name": "kind",
      "type": "select",
      "label": "$.product.kind",
      "options": [
        { "value": "food", "label": "$.product.kinds.food" },
        { "value": "treats", "label": "$.product.kinds.treats" },
        { "value": "toys", "label": "$.product.kinds.toys" },
        { "value": "hygiene", "label": "$.product.kinds.hygiene" },
        { "value": "equipment", "label": "$.product.kinds.equipment" },
        { "value": "supplements", "label": "$.product.kinds.supplements" },
        { "value": "other", "label": "$.product.kinds.other" }
      ],
      "clearable": true
    },
    { "name": "price", "type": "number", "label": "$.product.price", "clearable": true },
    { "name": "stock_quantity", "type": "number", "label": "$.product.stock", "clearable": true },
    {
      "name": "published",
      "type": "select",
      "label": "$.product.published",
      "options": [
        { "value": 1, "label": "$.form.yes" },
        { "value": 0, "label": "$.form.no" }
      ],
      "clearable": true
    }
  ]
}
